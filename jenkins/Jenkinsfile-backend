pipeline {
  agent none
  options {
    skipStagesAfterUnstable()
    skipDefaultCheckout()
  }
  environment {
    IMAGE_BASE = 'adilaboba/microservices-backend'
    IMAGE_TAG = "v$BUILD_NUMBER"
    IMAGE_NAME = "${env.IMAGE_BASE}:${env.IMAGE_TAG}"
    IMAGE_NAME_LATEST = "${env.IMAGE_BASE}:latest"
    DOCKERFILE_NAME = "Dockerfile-packaged"
    MAVEN_OPTS = '-Xmx512m -Xms128m'
  }
  stages {
    stage('Checkout') {
      agent any
      steps {
        deleteDir()
        git url: 'https://github.com/ad1l-aboba/microservices-backend.git',
            branch: 'master',
            credentialsId: 'github-creds'
        stash name: 'src', excludes: '.git/**'
      }
    }

    stage("Prepare container") {
      agent {
        docker {
          image 'openjdk:11.0.5-slim'
          args '-v $HOME/.m2:/root/.m2'
        }
      }
      stages {
        stage('Build') {
          steps {
            unstash 'src'
            sh 'chmod +x mvnw && ./mvnw compile'
          }
        }
        stage('Test') {
    steps {
        sh './mvnw test -DargLine=-Xmx512m'
        junit allowEmptyResults: true, testResults: '**/target/surefire-reports/TEST-*.xml'
    }
}
        stage('Package') {
          steps {
            sh './mvnw package -DskipTests'
            stash name: 'artifact', includes: 'target/*.jar, Dockerfile-packaged'
          }
        }
      }
    }

    stage('Push images') {
      agent any
      steps {
        unstash 'artifact'
        script {
          def dockerImage = docker.build("${env.IMAGE_NAME}", "-f ${env.DOCKERFILE_NAME} .")
          docker.withRegistry('', 'dockerhub-creds') {
            dockerImage.push()
            dockerImage.push("latest")
          }
          echo "Pushed Docker Image: ${env.IMAGE_NAME}"
        }
        sh "docker rmi ${env.IMAGE_NAME} ${env.IMAGE_NAME_LATEST}"
      }
    }

    stage('Trigger kubernetes') {
      agent any
      steps {
        // skipTlsVerify нужен, потому что сертификат k3s самоподписанный
        withKubeConfig([credentialsId: 'kubernetes-creds', serverUrl: "${CLUSTER_URL}", namespace: "${CLUSTER_NAMESPACE}", skipTlsVerify: true]) {
          sh "helm upgrade --install ${HELM_PROJECT} ${HELM_CHART} --reuse-values --set backend.image.tag=${env.IMAGE_TAG} --set backend.image.name=${env.IMAGE_BASE}"
        }
      }
    }
  }
}
